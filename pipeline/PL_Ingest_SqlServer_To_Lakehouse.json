{
	"name": "PL_Ingest_SqlServer_To_Lakehouse",
	"properties": {
		"description": "Metadata-driven ingestion, modeled on ghanse/gh-orchestration-adf pipeline_complex. Lookup a SQL Server control table, then a first ForEach copies each table to ADLS bronze (the Lookup -> ForEach -> Copy motif), and a second ForEach runs a Databricks notebook per table. Web activities notify on success/failure. Source for the flowx 'rearchitecture in flight' demo.",
		"activities": [
			{
				"name": "LKP_GetActiveTables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT source_schema, source_table, target_table, load_type, watermark_column FROM ', pipeline().parameters.p_control_schema, '.', pipeline().parameters.p_control_table, ' WHERE is_active = 1 ORDER BY load_priority')",
							"type": "Expression"
						},
						"queryTimeout": "00:05:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_Sql_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_CopyEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_GetActiveTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_GetActiveTables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 4,
					"activities": [
						{
							"name": "CP_SqlToBronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT * FROM ', item().source_schema, '.', item().source_table)",
										"type": "Expression"
									},
									"queryTimeout": "00:30:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_Sql_Source_Table",
									"type": "DatasetReference",
									"parameters": {
										"schemaName": "@item().source_schema",
										"tableName": "@item().source_table"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Adls_Parquet_Sink",
									"type": "DatasetReference",
									"parameters": {
										"folderPath": "@concat(pipeline().parameters.p_landing_container, '/', item().target_table, '/', pipeline().parameters.p_run_date)",
										"fileName": "@concat(item().source_table, '.parquet')"
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "FE_TransformEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FE_CopyEachTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_GetActiveTables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 4,
					"activities": [
						{
							"name": "NB_TransformTable",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "@concat(pipeline().parameters.p_databricks_repo, '/transform_table')",
									"type": "Expression"
								},
								"baseParameters": {
									"target_table": {
										"value": "@item().target_table",
										"type": "Expression"
									},
									"load_type": {
										"value": "@item().load_type",
										"type": "Expression"
									},
									"watermark_column": {
										"value": "@item().watermark_column",
										"type": "Expression"
									},
									"run_date": {
										"value": "@pipeline().parameters.p_run_date",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureDatabricks",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "WEB_NotifyPipelineSuccess",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "FE_TransformEachTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.p_notify_url",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('{\"level\":\"pipeline\",\"pipeline\":\"', pipeline().Pipeline, '\",\"runId\":\"', pipeline().RunId, '\",\"status\":\"SUCCEEDED\",\"runDate\":\"', pipeline().parameters.p_run_date, '\"}')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "WEB_NotifyCopyFailure",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "FE_CopyEachTable",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.p_notify_url",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('{\"level\":\"pipeline\",\"stage\":\"copy\",\"pipeline\":\"', pipeline().Pipeline, '\",\"runId\":\"', pipeline().RunId, '\",\"status\":\"FAILED\"}')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "WEB_NotifyTransformFailure",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "FE_TransformEachTable",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.p_notify_url",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('{\"level\":\"pipeline\",\"stage\":\"transform\",\"pipeline\":\"', pipeline().Pipeline, '\",\"runId\":\"', pipeline().RunId, '\",\"status\":\"FAILED\"}')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_control_schema": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"p_control_table": {
				"type": "String",
				"defaultValue": "MigrationControl"
			},
			"p_landing_container": {
				"type": "String",
				"defaultValue": "bronze"
			},
			"p_run_date": {
				"type": "String",
				"defaultValue": "2026-09-22"
			},
			"p_notify_url": {
				"type": "String",
				"defaultValue": "https://hooks.example.com/adf/failure"
			},
			"p_databricks_repo": {
				"type": "String",
				"defaultValue": "/Repos/flowx-demo"
			}
		},
		"variables": {
			"v_pipeline_status": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Migration/Ingestion"
		},
		"annotations": [
			"flowx-demo",
			"metadata-driven",
			"lookup-foreach-copy",
			"second-foreach-notebooks",
			"rearchitecture-in-flight"
		],
		"lastPublishTime": "2026-09-22T14:36:19Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}